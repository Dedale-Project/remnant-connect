{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "remnant-agent": {
      "type": "streamable-http",
      "url": "https://remnant.dedale-bi.com/mcp/agent-connect?profile=chatgpt-v1",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://remnant.dedale-bi.com/mcp/agent-connect",
            "baseScopes": ["agent:read", "memory:read", "memory:write", "memory:feedback"],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
